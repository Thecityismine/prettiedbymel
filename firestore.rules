rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Clients — app reads/writes from the browser client SDK
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Settings (pricing menu, alert digest)
    match /settings/{doc} {
      allow read, write: if true;
    }

    // Block any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
