rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Client profiles — readable/writable by the owner
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Clients collection — admin only (managed via admin dashboard)
    match /clients/{clientId} {
      allow read, write: if isAuthenticated();
    }

    // Appointments — admin can read/write all; clients can only read their own
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.clientId == "walk-in"
      );
      allow write: if isAuthenticated();
    }

    // Settings (availability) — any authenticated user can read for booking flow
    match /settings/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
